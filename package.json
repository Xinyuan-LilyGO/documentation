{
  "name": "lilygo-vitepress-wiki",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vitepress dev --host",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "check:links": "npm run check:links:internal && npm run check:links:external",
    "check:links:staged": "npm run check:links:internal -- --staged && npm run check:links:external -- --staged",
    "check:links:internal": "node scripts/check-internal-links.mjs",
    "check:links:external": "node scripts/check-external-links.mjs",
    "test:links": "node --test scripts/check-*-links.test.mjs"
  },
  "dependencies": {
    "@giscus/vue": "^3.1.1",
    "esptool-js": "^0.5.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "@types/parse5": "^6.0.3",
    "js-yaml": "^4.1.0",
    "parse5": "^8.0.1",
    "vitepress": "^1.6.4"
  }
}
